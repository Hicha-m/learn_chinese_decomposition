# Environment variables for Chinese character learning application
# Copy this file to .env and fill in your actual values

# Base directory for data files (relative or absolute path)
DIR=./

# Google Gemini API key (for AI-powered character explanations)
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY

# OpenRouter API key (for alternative AI models)
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
